# Production (example)
# Copy to `.env.production` and adjust if needed.

# API base URL (NO /api suffix)
VITE_API_BASE_URL=https://api.piueducation.org

# API base URL with version path
VITE_API_URL=https://api.piueducation.org/api/v1

# Site name
VITE_APP_NAME=PIU Admin Portal

# Environment label
VITE_ENV=production

# Session timeout (minutes)
VITE_SESSION_TIMEOUT=60

# reCAPTCHA v3 site key (public — pairs with backend RECAPTCHA_SECRET_KEY)
# Production: 6LewVqssAAAAAFrjyj_dvwYZgQoFEFng_cIRHE7T
VITE_RECAPTCHA_SITE_KEY=6LewVqssAAAAAFrjyj_dvwYZgQoFEFng_cIRHE7T

# Google OAuth client ID (public; used by Sign in with Google button)
VITE_GOOGLE_CLIENT_ID=632332521678-g0oe8rod5qq9muv0q5e5v7r4o084mp1v.apps.googleusercontent.com

